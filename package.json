{
  "name": "servo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "art": "node packages/tools/src/placeholder-art/main.ts",
    "dev": "pnpm --filter @servo/app dev",
    "build": "pnpm --filter @servo/app build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint --config eslint.config.js --max-warnings 0 .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "e2e": "pnpm art && pnpm --filter @servo/tools e2e",
    "golden": "node packages/tools/src/golden-runs/main.ts",
    "validate-content": "node packages/tools/src/validate-content/main.ts",
    "release:dry": "node packages/tools/src/release/main.ts",
    "release:preview": "pnpm --filter @servo/app exec vite preview --outDir ../../dist/release/web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.0",
    "vite": "catalog:"
  }
}
