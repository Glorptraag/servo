  "goalLine": "Put each large wheel on a gearbox's output shaft, so the robot drives straight",
  "hints": [
    {
      "steps": [
        {
          "line": "This large wheel needs a shaft in its hub",
          "step": "pulse-part",
          "target": {
            "placed": "wheel-left"
          }
        },
        {
          "line": "This gearbox's output shaft turns with nothing on it",
          "step": "pulse-port",
          "target": {
            "placed": "gear-left",
            "port": "output"
          }
        },
        {
          "from": {
            "placed": "gear-left",
            "port": "output"
          },
          "line": "Output shaft into the hub",
          "step": "ghost-wire",
          "to": {
            "placed": "wheel-left",
            "port": "hub"
          }
        },
        {
          "changes": [
            {
              "from": {
                "placed": "gear-left",
                "port": "output"
              },
              "kind": "add-wire",
              "to": {
                "placed": "wheel-left",
                "port": "hub"
              }
            }
          ],
          "line": "Put the large wheel on this gearbox's output shaft",
          "step": "do-it"
        }
      ],
      "when": {
        "kind": "unwired",
        "placed": "wheel-left",
        "port": "hub"
      }
    },
    {
