{
  "arena": {
    "preset": "open-floor",
    "props": []
  },
  "goal": {
    "kind": "sequence",
    "of": [
      {
        "forTicks": 15,
        "kind": "holds",
        "when": {
          "atLeast": 200,
          "kind": "forward-speed",
          "target": {
            "placed": "chassis"
          }
        }
      },
      {
        "forTicks": 15,
        "kind": "holds",
        "when": {
          "kind": "and",
          "of": [
            {
              "kind": "state",
              "state": "open",
              "target": {
                "placed": "switch"
              }
            },
            {
              "atMost": 5,
              "kind": "speed",
              "target": {
                "placed": "chassis"
              }
            }
          ]
        }
      }
    ]
  },
  "goalLine": "Put the switch in the motor driver's power line, then press it to stop the robot",
  "hints": [
    {
      "steps": [
        {
          "line": "The switch goes in the power line",
          "step": "pulse-part",
          "target": {
            "placed": "switch"
          }
        },
        {
          "line": "Side A takes power from the battery pack",
          "step": "pulse-port",
          "target": {
            "placed": "switch",
            "port": "a"
          }
        },
        {
          "from": {
            "placed": "battery",
            "port": "plus"
          },
          "line": "Plus to side A",
          "step": "ghost-wire",
          "to": {
            "placed": "switch",
            "port": "a"
          }
        },
        {
          "changes": [
            {
              "from": {
                "placed": "battery",
                "port": "plus"
              },
              "kind": "add-wire",
              "to": {
                "placed": "switch",
                "port": "a"
              }
            }
          ],
          "line": "Wired the battery pack's plus to side A",
          "step": "do-it"
        }
      ],
      "when": {
        "kind": "unwired",
        "placed": "switch",
        "port": "a"
      }
    },
    {
      "steps": [
        {
          "line": "This motor driver has no power in",
          "step": "pulse-part",
          "target": {
            "placed": "driver"
          }
        },
        {
          "line": "Power in takes plus from side B of the switch",
          "step": "pulse-port",
          "target": {
            "placed": "driver",
            "port": "plus"
          }
        },
        {
          "from": {
            "placed": "switch",
            "port": "b"
          },
          "line": "Side B to the motor driver's power in",
          "step": "ghost-wire",
          "to": {
            "placed": "driver",
            "port": "plus"
          }
        },
        {
          "changes": [
            {
              "from": {
                "placed": "switch",
                "port": "b"
              },
              "kind": "add-wire",
              "to": {
                "placed": "driver",
                "port": "plus"
              }
            }
          ],
          "line": "Wired side B to the motor driver's power in",
          "step": "do-it"
        }
      ],
      "when": {
        "kind": "unwired",
        "placed": "driver",
        "port": "plus"
      }
    },
    {
      "steps": [
        {
          "line": "This switch is not in a loop with the battery pack",
          "step": "pulse-part",
          "target": {
            "placed": "switch"
          }
        },
        {
          "line": "The motor driver's power in takes plus straight from the battery pack, round the switch",
          "step": "pulse-port",
          "target": {
            "placed": "driver",
            "port": "plus"
          }
        },
        {
          "changes": [
            {
              "from": {
                "placed": "battery",
                "port": "plus"
              },
              "kind": "remove-wire",
              "to": {
                "placed": "driver",
                "port": "plus"
              }
            },
            {
              "from": {
                "placed": "switch",
                "port": "b"
              },
              "kind": "add-wire",
              "to": {
                "placed": "driver",
                "port": "plus"
              }
            },
            {
              "from": {
                "placed": "battery",
                "port": "plus"
              },
              "kind": "add-wire",
              "to": {
                "placed": "switch",
                "port": "a"
              }
            }
          ],
          "line": "Moved the motor driver's power in from the battery pack to side B of the switch",
          "step": "do-it"
        }
      ],
      "when": {
        "failure": "outside-loop",
        "kind": "fault",
        "target": {
          "placed": "switch"
        }
      }
    },
    {
      "steps": [
        {
          "line": "The switch stops only what is wired to side B",
          "step": "pulse-part",
          "target": {
            "placed": "switch"
          }
        },
        {
          "line": "The motor driver's power in belongs on side B",
          "step": "pulse-port",
          "target": {
            "placed": "switch",
            "port": "b"
          }
        },
        {
          "changes": [
            {
              "from": {
                "placed": "battery",
                "port": "plus"
              },
              "kind": "remove-wire",
              "to": {
                "placed": "driver",
                "port": "plus"
              }
            },
            {
              "from": {
                "placed": "switch",
                "port": "b"
              },
              "kind": "add-wire",
              "to": {
                "placed": "driver",
                "port": "plus"
              }
            },
            {
              "from": {
                "placed": "battery",
                "port": "plus"
              },
              "kind": "add-wire",
              "to": {
                "placed": "switch",
                "port": "a"
              }
            }
          ],
          "line": "Moved the motor driver's power in to side B of the switch",
          "step": "do-it"
        }
      ]
    }
  ],
  "id": "stop-the-motor-driver",
  "kind": "guided",
