    "props": []
  },
  "goal": {
    "forTicks": 30,
    "kind": "holds",
    "when": {
      "atLeast": 60,
      "atMost": 220,
      "kind": "forward-speed",
      "target": {
        "placed": "chassis"
      }
    }
  },
  "goalLine": "Swap the 2-cell battery pack for the 1-cell battery pack, then Run the robot and watch its speed",
  "hints": [
    {
      "steps": [
        {
          "line": "This battery pack has no loop back to minus",
          "step": "pulse-part",
          "target": {
            "part": "battery-pack-1-cell"
          }
        },
        {
          "line": "Its plus feeds side A of the switch",
          "step": "pulse-port",
          "target": {
            "part": "battery-pack-1-cell",
            "port": "plus"
          }
        },
        {
          "changes": [
            {
              "from": {
                "placed": "motor-left",
                "port": "minus"
              },
              "kind": "add-wire",
              "to": {
                "part": "battery-pack-1-cell",
                "port": "minus"
              }
            },
            {
              "from": {
                "placed": "motor-right",
                "port": "minus"
              },
              "kind": "add-wire",
              "to": {
                "part": "battery-pack-1-cell",
                "port": "minus"
              }
            },
            {
              "from": {
                "part": "battery-pack-1-cell",
                "port": "plus"
              },
              "kind": "add-wire",
              "to": {
                "placed": "switch",
                "port": "a"
              }
            }
          ],
          "line": "Wired the 1-cell battery pack to side A of the switch and to both DC motors",
          "step": "do-it"
        }
      ],
      "when": {
        "failure": "no-loop",
        "kind": "fault",
        "target": {
          "part": "battery-pack-1-cell"
        }
      }
    },
    {
      "steps": [
        {
          "line": "The rear deck holds the battery pack",
          "step": "pulse-part",
          "target": {
            "placed": "chassis"
          }
        },
        {
          "line": "The 1-cell battery pack fixes to the rear deck",
          "step": "pulse-port",
          "target": {
            "placed": "chassis",
            "port": "deck-rear"
          }
        },
        {
          "changes": [
            {
              "kind": "add-part",
              "mountOn": {
                "placed": "chassis",
                "port": "deck-rear"
              },
              "part": "battery-pack-1-cell"
            },
            {
              "from": {
                "placed": "motor-left",
                "port": "minus"
              },
              "kind": "add-wire",
              "to": {
                "part": "battery-pack-1-cell",
                "port": "minus"
              }
            },
            {
              "from": {
                "placed": "motor-right",
                "port": "minus"
              },
              "kind": "add-wire",
              "to": {
                "part": "battery-pack-1-cell",
                "port": "minus"
              }
            },
            {
              "from": {
                "part": "battery-pack-1-cell",
                "port": "plus"
              },
              "kind": "add-wire",
              "to": {
                "placed": "switch",
                "port": "a"
              }
            }
          ],
          "line": "Fixed the 1-cell battery pack to the rear deck and wired it",
          "step": "do-it"
        }
      ],
      "when": {
        "kind": "missing",
        "part": "battery-pack-2-cell"
      }
    },
    {
      "steps": [
        {
          "line": "This 2-cell battery pack can swap for the 1-cell battery pack",
          "step": "pulse-part",
          "target": {
            "placed": "battery"
          }
        },
        {
          "line": "Its plus feeds side A of the switch",
          "step": "pulse-port",
          "target": {
            "placed": "battery",
            "port": "plus"
          }
        },
        {
          "changes": [
            {
              "kind": "remove-part",
              "target": {
                "placed": "battery"
              }
            },
            {
              "kind": "add-part",
              "mountOn": {
                "placed": "chassis",
                "port": "deck-rear"
              },
              "part": "battery-pack-1-cell"
            },
            {
              "from": {
                "placed": "motor-left",
                "port": "minus"
              },
              "kind": "add-wire",
              "to": {
                "part": "battery-pack-1-cell",
                "port": "minus"
              }
            },
            {
              "from": {
                "placed": "motor-right",
                "port": "minus"
              },
              "kind": "add-wire",
              "to": {
                "part": "battery-pack-1-cell",
                "port": "minus"
              }
            },
            {
              "from": {
                "part": "battery-pack-1-cell",
                "port": "plus"
              },
              "kind": "add-wire",
              "to": {
                "placed": "switch",
                "port": "a"
              }
            }
          ],
          "line": "Swapped the 2-cell battery pack for the 1-cell battery pack",
          "step": "do-it"
        }
      ]
    }
  ],
