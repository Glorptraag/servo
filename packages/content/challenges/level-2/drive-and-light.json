  },
  "goal": {
    "forTicks": 15,
    "kind": "holds",
    "when": {
      "kind": "and",
      "of": [
        {
          "atLeast": 200,
          "kind": "forward-speed",
          "target": {
            "placed": "chassis"
          }
        },
        {
          "kind": "state",
          "state": "lit",
          "target": {
            "placed": "led"
          }
        }
      ]
    }
  },
  "goalLine": "Make the robot drive forward and light the LED at the same time",
  "hints": [
    {
      "steps": [
        {
          "line": "This LED's plus and minus are swapped",
          "step": "pulse-part",
          "target": {
            "placed": "led"
          }
        },
        {
          "line": "The LED's long leg, its plus, takes power from side B of the switch",
          "step": "pulse-port",
          "target": {
            "placed": "led",
            "port": "plus"
          }
        },
        {
          "changes": [
            {
              "from": {
                "placed": "battery",
                "port": "minus"
              },
              "kind": "remove-wire",
              "to": {
                "placed": "led",
                "port": "plus"
              }
            },
            {
              "from": {
                "placed": "switch",
                "port": "b"
              },
              "kind": "remove-wire",
              "to": {
                "placed": "led",
                "port": "minus"
              }
            },
            {
              "from": {
                "placed": "battery",
                "port": "plus"
              },
              "kind": "remove-wire",
              "to": {
                "placed": "led",
                "port": "minus"
              }
            },
            {
              "from": {
                "placed": "battery",
                "port": "plus"
              },
              "kind": "remove-wire",
              "to": {
                "placed": "led",
                "port": "plus"
              }
            },
            {
              "from": {
                "placed": "switch",
                "port": "b"
              },
              "kind": "add-wire",
              "to": {
                "placed": "led",
                "port": "plus"
              }
            },
            {
              "from": {
                "placed": "led",
                "port": "minus"
              },
              "kind": "add-wire",
              "to": {
                "placed": "battery",
                "port": "minus"
              }
            }
          ],
          "line": "Swapped the LED's plus and minus lines",
          "step": "do-it"
        }
      ],
      "when": {
        "failure": "reversed",
        "kind": "fault",
        "target": {
          "placed": "led"
        }
      }
    },
    {
      "steps": [
        {
          "line": "This LED is not in a loop with the battery pack",
          "step": "pulse-part",
          "target": {
            "placed": "led"
          }
        },
        {
          "line": "The LED's long leg, its plus, takes power from side B of the switch",
          "step": "pulse-port",
          "target": {
            "placed": "led",
            "port": "plus"
          }
        },
        {
          "from": {
            "placed": "switch",
            "port": "b"
          },
          "line": "Side B to the LED's plus",
          "step": "ghost-wire",
          "to": {
            "placed": "led",
            "port": "plus"
          }
        },
        {
          "changes": [
            {
              "from": {
                "placed": "switch",
                "port": "b"
              },
              "kind": "add-wire",
              "to": {
                "placed": "led",
                "port": "plus"
              }
            }
          ],
          "line": "Wired side B to the LED's plus",
          "step": "do-it"
        }
      ],
      "when": {
        "kind": "unwired",
        "placed": "led",
        "port": "plus"
      }
    },
    {
      "steps": [
        {
          "line": "This LED has power in but no way out",
          "step": "pulse-part",
          "target": {
            "placed": "led"
          }
        },
        {
          "line": "Power comes out at the LED's minus",
          "step": "pulse-port",
          "target": {
            "placed": "led",
            "port": "minus"
          }
        },
        {
          "from": {
            "placed": "led",
            "port": "minus"
          },
          "line": "Minus back to minus",
          "step": "ghost-wire",
          "to": {
            "placed": "battery",
            "port": "minus"
          }
        },
        {
          "changes": [
            {
              "from": {
                "placed": "led",
                "port": "minus"
              },
              "kind": "add-wire",
              "to": {
                "placed": "battery",
                "port": "minus"
              }
            }
          ],
          "line": "Wired the LED's minus back to the battery pack's minus",
          "step": "do-it"
        }
      ],
      "when": {
        "kind": "unwired",
        "placed": "led",
        "port": "minus"
      }
    },
    {
      "steps": [
        {
          "line": "The LED lights when power flows from its long leg to its short leg",
          "step": "pulse-part",
          "target": {
            "placed": "led"
          }
        },
        {
          "line": "The LED's long leg takes power from side B",
          "step": "pulse-port",
          "target": {
            "placed": "switch",
            "port": "b"
          }
        },
        {
          "changes": [
            {
              "from": {
                "placed": "battery",
                "port": "minus"
              },
              "kind": "remove-wire",
              "to": {
                "placed": "led",
                "port": "plus"
              }
            },
            {
              "from": {
                "placed": "switch",
                "port": "b"
              },
              "kind": "remove-wire",
              "to": {
                "placed": "led",
                "port": "minus"
              }
            },
            {
              "from": {
                "placed": "battery",
                "port": "plus"
              },
              "kind": "remove-wire",
              "to": {
                "placed": "led",
                "port": "minus"
              }
            },
            {
              "from": {
                "placed": "battery",
                "port": "plus"
              },
              "kind": "remove-wire",
              "to": {
                "placed": "led",
                "port": "plus"
              }
            },
            {
              "from": {
                "placed": "switch",
                "port": "b"
              },
              "kind": "add-wire",
              "to": {
                "placed": "led",
                "port": "plus"
              }
            },
            {
              "from": {
                "placed": "led",
                "port": "minus"
              },
              "kind": "add-wire",
              "to": {
                "placed": "battery",
                "port": "minus"
              }
            }
          ],
          "line": "Wired the LED's long leg to side B and its short leg back to minus",
          "step": "do-it"
        }
      ]
    }
  ],
