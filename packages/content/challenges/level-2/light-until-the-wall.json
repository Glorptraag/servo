  "goalLine": "Make the LED light while the robot drives, and go dark when the bumper switch meets the wall",
  "hints": [
    {
      "steps": [
        {
          "line": "This LED's plus and minus are swapped",
          "step": "pulse-part",
          "target": {
            "placed": "led"
          }
        },
        {
          "line": "The LED's long leg, its plus, takes power from side B of the bumper switch",
          "step": "pulse-port",
          "target": {
            "placed": "led",
            "port": "plus"
          }
        },
        {
          "changes": [
            {
              "from": {
                "placed": "battery",
                "port": "minus"
              },
              "kind": "remove-wire",
              "to": {
                "placed": "led",
                "port": "plus"
              }
            },
            {
              "from": {
