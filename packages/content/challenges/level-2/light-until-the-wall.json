    },
    {
      "steps": [
        {
          "line": "This LED is not in a loop with the battery pack",
          "step": "pulse-part",
          "target": {
            "placed": "led"
          }
        },
        {
          "line": "The LED's long leg, its plus, takes power from side B of the bumper switch",
          "step": "pulse-port",
          "target": {
            "placed": "led",
            "port": "plus"
          }
        },
        {
          "from": {
            "placed": "bumper",
            "port": "b"
          },
          "line": "Side B to the LED's plus",
          "step": "ghost-wire",
          "to": {
            "placed": "led",
            "port": "plus"
          }
        },
        {
          "changes": [
            {
              "from": {
                "placed": "bumper",
                "port": "b"
              },
              "kind": "add-wire",
              "to": {
                "placed": "led",
                "port": "plus"
              }
            }
          ],
          "line": "Wired side B to the LED's plus",
          "step": "do-it"
        }
      ],
      "when": {
        "kind": "unwired",
        "placed": "led",
        "port": "plus"
      }
    },
    {
      "steps": [
        {
          "line": "This LED has power in but no way out",
          "step": "pulse-part",
          "target": {
            "placed": "led"
          }
        },
        {
          "line": "Power comes out at the LED's minus",
          "step": "pulse-port",
          "target": {
            "placed": "led",
            "port": "minus"
          }
        },
        {
          "from": {
            "placed": "led",
            "port": "minus"
          },
          "line": "Minus back to minus",
          "step": "ghost-wire",
          "to": {
            "placed": "battery",
            "port": "minus"
          }
        },
        {
          "changes": [
            {
              "from": {
                "placed": "led",
                "port": "minus"
              },
              "kind": "add-wire",
              "to": {
                "placed": "battery",
                "port": "minus"
              }
            }
          ],
          "line": "Wired the LED's minus back to the battery pack's minus",
          "step": "do-it"
        }
      ],
      "when": {
        "kind": "unwired",
