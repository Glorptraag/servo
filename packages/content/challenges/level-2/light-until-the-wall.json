                "placed": "led",
                "port": "minus"
              },
              "kind": "add-wire",
              "to": {
                "placed": "battery",
                "port": "minus"
              }
            }
          ],
          "line": "Swapped the LED's plus and minus lines",
          "step": "do-it"
        }
      ],
      "when": {
        "failure": "reversed",
        "kind": "fault",
        "target": {
          "placed": "led"
        }
