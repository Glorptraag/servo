{
  "arena": {
    "preset": "open-floor",
    "props": []
  },
  "goal": {
    "forTicks": 30,
    "kind": "holds",
    "when": {
      "atLeast": 10,
      "kind": "turn-rate",
      "target": {
        "placed": "chassis"
      }
    }
  },
  "goalLine": "Swap one large wheel for a small wheel, then Run the robot and watch where it goes",
  "hints": [
    {
      "steps": [
        {
          "line": "This small wheel is not on a shaft",
          "step": "pulse-part",
          "target": {
            "part": "wheel-small"
          }
        },
        {
          "line": "The small wheel goes on this shaft once the large wheel is off",
          "step": "pulse-port",
          "target": {
            "placed": "motor-right",
            "port": "shaft"
          }
        },
        {
          "changes": [
            {
              "kind": "remove-part",
              "target": {
                "part": "wheel-small"
              }
            }
          ],
          "line": "Put the loose small wheel back in the tray, ready to swap",
          "step": "do-it"
        }
      ],
      "when": {
        "kind": "unwired",
        "part": "wheel-small",
        "port": "hub"
      }
    },
    {
      "steps": [
        {
          "line": "This DC motor's shaft turns with nothing on it",
          "step": "pulse-part",
          "target": {
            "placed": "motor-right"
          }
        },
        {
          "line": "A small wheel goes on this shaft",
          "step": "pulse-port",
          "target": {
            "placed": "motor-right",
            "port": "shaft"
          }
        },
        {
          "changes": [
            {
              "kind": "add-part",
              "part": "wheel-small"
            },
            {
              "from": {
                "placed": "motor-right",
                "port": "shaft"
              },
              "kind": "add-wire",
              "to": {
                "part": "wheel-small",
                "port": "hub"
              }
            }
          ],
          "line": "Put a small wheel on this DC motor's shaft",
          "step": "do-it"
        }
      ],
      "when": {
        "kind": "unwired",
        "placed": "motor-right",
        "port": "shaft"
      }
    },
    {
      "steps": [
        {
          "line": "This large wheel can swap for a small wheel",
          "step": "pulse-part",
          "target": {
            "placed": "wheel-right"
          }
        },
        {
          "line": "Its hub sits on the DC motor's shaft",
          "step": "pulse-port",
          "target": {
            "placed": "wheel-right",
            "port": "hub"
          }
        },
        {
          "changes": [
            {
              "kind": "remove-part",
              "target": {
                "placed": "wheel-right"
              }
            },
            {
              "kind": "add-part",
              "part": "wheel-small"
            },
            {
              "from": {
                "placed": "motor-right",
                "port": "shaft"
              },
              "kind": "add-wire",
              "to": {
                "part": "wheel-small",
                "port": "hub"
              }
            }
          ],
          "line": "Swapped this large wheel for a small wheel",
          "step": "do-it"
        }
      ]
    }
  ],
  "id": "what-if-one-small-wheel",
  "kind": "what-if",
