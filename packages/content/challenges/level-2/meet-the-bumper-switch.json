{
  "arena": {
    "preset": "wall-stop",
    "props": []
  },
  "goal": {
    "kind": "sequence",
    "of": [
      {
        "forTicks": 15,
        "kind": "holds",
        "when": {
          "atLeast": 200,
          "kind": "forward-speed",
          "target": {
            "placed": "chassis"
          }
        }
      },
      {
        "forTicks": 15,
        "kind": "holds",
        "when": {
          "kind": "and",
          "of": [
            {
              "kind": "near-wall",
              "target": {
                "placed": "chassis"
              },
              "wall": "far-wall",
              "withinMm": 40
            },
            {
              "atMost": 5,
              "kind": "speed",
              "target": {
                "placed": "chassis"
              }
            },
            {
              "kind": "state",
              "state": "open",
              "target": {
                "placed": "bumper"
              }
            },
            {
              "kind": "not",
              "of": {
                "kind": "state",
                "state": "powered",
                "target": {
                  "part": "dc-motor"
                }
              }
            }
          ]
        }
      }
    ]
  },
  "goalLine": "Put the bumper switch in the power line, so the robot stops when it bumps the wall",
  "hints": [
    {
      "steps": [
        {
          "line": "The bumper switch goes in the power line",
          "step": "pulse-part",
          "target": {
            "placed": "bumper"
          }
        },
        {
          "line": "Side A takes power from the battery pack",
          "step": "pulse-port",
          "target": {
            "placed": "bumper",
            "port": "a"
          }
        },
        {
          "from": {
            "placed": "battery",
            "port": "plus"
          },
          "line": "Plus to side A",
          "step": "ghost-wire",
          "to": {
            "placed": "bumper",
            "port": "a"
          }
        },
        {
          "changes": [
            {
              "from": {
                "placed": "battery",
                "port": "plus"
              },
              "kind": "add-wire",
              "to": {
                "placed": "bumper",
                "port": "a"
              }
            }
          ],
          "line": "Wired the battery pack's plus to side A",
          "step": "do-it"
        }
      ],
      "when": {
        "kind": "unwired",
        "placed": "bumper",
        "port": "a"
      }
    },
    {
      "steps": [
        {
          "line": "This bumper switch is not in a loop with the battery pack",
          "step": "pulse-part",
          "target": {
            "placed": "bumper"
          }
        },
        {
          "line": "Side B sends power on to the DC motors",
          "step": "pulse-port",
          "target": {
            "placed": "bumper",
            "port": "b"
          }
        },
        {
          "changes": [
            {
              "from": {
                "placed": "bumper",
                "port": "b"
              },
              "kind": "add-wire",
              "to": {
                "placed": "motor-left",
                "port": "plus"
              }
            },
            {
              "from": {
                "placed": "bumper",
                "port": "b"
              },
              "kind": "add-wire",
              "to": {
                "placed": "motor-right",
                "port": "plus"
              }
            }
          ],
          "line": "Wired side B to both DC motors' plus",
          "step": "do-it"
        }
      ],
      "when": {
        "kind": "unwired",
        "placed": "bumper",
        "port": "b"
      }
    },
    {
      "steps": [
        {
          "line": "This bumper switch is not in a loop with the battery pack",
          "step": "pulse-part",
          "target": {
            "placed": "bumper"
          }
        },
        {
          "line": "This DC motor's plus takes power straight from the battery pack, round the bumper switch",
          "step": "pulse-port",
          "target": {
            "placed": "motor-left",
            "port": "plus"
          }
        },
        {
          "changes": [
            {
              "from": {
                "placed": "battery",
                "port": "plus"
              },
              "kind": "remove-wire",
              "to": {
                "placed": "motor-left",
                "port": "plus"
              }
            },
            {
              "from": {
                "placed": "battery",
                "port": "plus"
              },
              "kind": "remove-wire",
              "to": {
                "placed": "motor-right",
                "port": "plus"
              }
            },
            {
              "from": {
                "placed": "bumper",
                "port": "b"
              },
              "kind": "add-wire",
              "to": {
                "placed": "motor-left",
                "port": "plus"
              }
            },
            {
              "from": {
                "placed": "bumper",
                "port": "b"
              },
              "kind": "add-wire",
              "to": {
                "placed": "motor-right",
                "port": "plus"
              }
            },
            {
              "from": {
                "placed": "battery",
                "port": "plus"
              },
              "kind": "add-wire",
              "to": {
                "placed": "bumper",
                "port": "a"
              }
            }
          ],
          "line": "Moved both DC motors' plus lines from the battery pack to side B of the bumper switch",
          "step": "do-it"
        }
      ],
      "when": {
        "failure": "outside-loop",
        "kind": "fault",
        "target": {
          "placed": "bumper"
        }
      }
    },
    {
      "steps": [
        {
          "line": "The bumper switch stops only the DC motors wired to side B",
          "step": "pulse-part",
          "target": {
            "placed": "bumper"
          }
        },
        {
          "line": "Both DC motors' plus lines belong on side B",
          "step": "pulse-port",
          "target": {
            "placed": "bumper",
            "port": "b"
          }
        },
        {
          "changes": [
            {
              "from": {
                "placed": "battery",
                "port": "plus"
              },
              "kind": "remove-wire",
              "to": {
                "placed": "motor-left",
                "port": "plus"
              }
            },
            {
              "from": {
                "placed": "battery",
                "port": "plus"
              },
              "kind": "remove-wire",
              "to": {
                "placed": "motor-right",
                "port": "plus"
              }
            },
            {
              "from": {
                "placed": "bumper",
                "port": "b"
              },
              "kind": "add-wire",
              "to": {
                "placed": "motor-left",
                "port": "plus"
              }
            },
            {
              "from": {
                "placed": "bumper",
                "port": "b"
              },
              "kind": "add-wire",
              "to": {
                "placed": "motor-right",
                "port": "plus"
              }
            },
            {
              "from": {
                "placed": "battery",
                "port": "plus"
              },
              "kind": "add-wire",
              "to": {
                "placed": "bumper",
                "port": "a"
              }
            }
          ],
          "line": "Moved both DC motors' plus lines to side B of the bumper switch",
          "step": "do-it"
        }
      ]
    }
  ],
