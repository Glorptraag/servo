{
  "arena": {
    "preset": "open-floor",
    "props": []
  },
  "goal": {
    "forTicks": 30,
    "kind": "holds",
    "when": {
      "kind": "and",
      "of": [
        {
          "atLeast": 200,
          "kind": "forward-speed",
          "target": {
            "placed": "chassis"
          }
        },
        {
          "atMost": 10,
          "kind": "turn-rate",
          "target": {
            "placed": "chassis"
          }
        }
      ]
    }
  },
  "goalLine": "Find why the robot does not move, and fix it so it drives straight",
  "hints": [
    {
      "steps": [
        {
          "line": "This motor driver is not getting enough power",
          "step": "pulse-part",
          "target": {
            "placed": "driver"
          }
        },
        {
          "line": "This 1-cell battery pack gives half the push of a 2-cell battery pack",
          "step": "pulse-port",
          "target": {
            "placed": "battery",
            "port": "plus"
          }
        },
        {
          "changes": [
            {
              "kind": "remove-part",
              "target": {
                "placed": "battery"
              }
            },
            {
              "kind": "add-part",
              "mountOn": {
                "placed": "chassis",
                "port": "deck-rear"
              },
              "part": "battery-pack-2-cell"
            },
            {
              "from": {
                "placed": "driver",
                "port": "minus"
              },
              "kind": "add-wire",
              "to": {
                "part": "battery-pack-2-cell",
                "port": "minus"
              }
            },
            {
              "from": {
                "part": "battery-pack-2-cell",
                "port": "plus"
              },
              "kind": "add-wire",
              "to": {
                "placed": "switch",
                "port": "a"
              }
            }
          ],
          "line": "Swapped the 1-cell battery pack for a 2-cell battery pack",
          "step": "do-it"
        }
      ],
      "when": {
        "failure": "low-voltage",
        "kind": "fault",
        "target": {
          "placed": "driver"
        }
      }
    },
    {
      "steps": [
        {
          "line": "This battery pack is not in a loop with the motor driver",
          "step": "pulse-part",
          "target": {
            "part": "battery-pack-2-cell"
          }
        },
        {
          "line": "Its plus feeds side A of the switch",
          "step": "pulse-port",
          "target": {
            "part": "battery-pack-2-cell",
            "port": "plus"
          }
        },
        {
          "changes": [
            {
              "from": {
                "placed": "driver",
                "port": "minus"
              },
              "kind": "add-wire",
              "to": {
                "part": "battery-pack-2-cell",
                "port": "minus"
              }
            },
            {
              "from": {
                "part": "battery-pack-2-cell",
                "port": "plus"
              },
              "kind": "add-wire",
              "to": {
                "placed": "switch",
                "port": "a"
              }
            }
          ],
          "line": "Wired the 2-cell battery pack to side A of the switch and to the motor driver",
          "step": "do-it"
        }
      ],
      "when": {
        "kind": "unwired",
        "part": "battery-pack-2-cell",
        "port": "plus"
      }
    },
    {
      "steps": [
        {
          "line": "This battery pack has no loop back to minus",
          "step": "pulse-part",
          "target": {
            "part": "battery-pack-2-cell"
          }
        },
        {
          "line": "The motor driver's power in minus comes back here",
          "step": "pulse-port",
          "target": {
            "part": "battery-pack-2-cell",
            "port": "minus"
          }
        },
        {
          "changes": [
            {
              "from": {
                "placed": "driver",
                "port": "minus"
              },
              "kind": "add-wire",
              "to": {
                "part": "battery-pack-2-cell",
                "port": "minus"
              }
            },
            {
              "from": {
                "part": "battery-pack-2-cell",
                "port": "plus"
              },
              "kind": "add-wire",
              "to": {
                "placed": "switch",
                "port": "a"
              }
            }
          ],
          "line": "Wired the 2-cell battery pack to side A of the switch and to the motor driver",
          "step": "do-it"
        }
      ],
      "when": {
        "kind": "unwired",
        "part": "battery-pack-2-cell",
        "port": "minus"
      }
    },
    {
      "steps": [
        {
          "line": "This robot has no battery pack",
          "step": "pulse-part",
          "target": {
            "placed": "chassis"
          }
        },
        {
          "line": "A 2-cell battery pack fixes to the rear deck",
          "step": "pulse-port",
          "target": {
            "placed": "chassis",
            "port": "deck-rear"
          }
        },
        {
          "changes": [
            {
              "kind": "add-part",
              "mountOn": {
                "placed": "chassis",
                "port": "deck-rear"
              },
              "part": "battery-pack-2-cell"
            },
            {
              "from": {
                "placed": "driver",
                "port": "minus"
              },
              "kind": "add-wire",
              "to": {
                "part": "battery-pack-2-cell",
                "port": "minus"
              }
            },
            {
              "from": {
                "part": "battery-pack-2-cell",
                "port": "plus"
              },
              "kind": "add-wire",
              "to": {
                "placed": "switch",
                "port": "a"
              }
            }
          ],
          "line": "Fixed a 2-cell battery pack to the rear deck and wired it",
          "step": "do-it"
        }
      ],
      "when": {
        "kind": "missing",
        "part": "battery-pack-2-cell"
      }
    }
  ],
  "id": "weak-battery-pack",
  "kind": "breakdown",
  "kit": "circuit-crew",
  "level": 2,
