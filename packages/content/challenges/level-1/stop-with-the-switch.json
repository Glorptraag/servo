  },
  "goal": {
    "kind": "sequence",
    "of": [
      {
        "forTicks": 15,
        "kind": "holds",
        "when": {
          "atLeast": 200,
          "kind": "forward-speed",
          "target": {
            "placed": "chassis"
          }
        }
      },
      {
        "forTicks": 15,
        "kind": "holds",
        "when": {
          "kind": "and",
          "of": [
            {
              "kind": "state",
              "state": "open",
              "target": {
                "placed": "switch"
              }
            },
            {
              "atMost": 5,
              "kind": "speed",
              "target": {
                "placed": "chassis"
              }
            }
          ]
        }
      }
    ]
  },
  "goalLine": "Wire both DC motors through the switch, then press it to stop the robot",
  "hints": [
    {
      "steps": [
        {
          "line": "The switch goes in the power line",
          "step": "pulse-part",
          "target": {
            "placed": "switch"
          }
        },
        {
          "line": "Side A takes power from the battery pack",
          "step": "pulse-port",
          "target": {
            "placed": "switch",
            "port": "a"
          }
        },
        {
          "from": {
            "placed": "battery",
            "port": "plus"
          },
          "line": "Plus to side A",
          "step": "ghost-wire",
          "to": {
            "placed": "switch",
            "port": "a"
          }
        },
        {
          "changes": [
            {
              "from": {
                "placed": "battery",
                "port": "plus"
              },
              "kind": "add-wire",
              "to": {
                "placed": "switch",
                "port": "a"
              }
            }
          ],
          "line": "Wired the battery pack's plus to side A",
          "step": "do-it"
        }
      ],
      "when": {
        "kind": "unwired",
        "placed": "switch",
        "port": "a"
      }
    },
    {
      "steps": [
        {
          "line": "This DC motor is not in a loop with the battery pack",
          "step": "pulse-part",
          "target": {
            "placed": "motor-left"
          }
        },
        {
          "line": "Power goes in at this DC motor's plus",
          "step": "pulse-port",
          "target": {
            "placed": "motor-left",
            "port": "plus"
          }
        },
        {
          "from": {
            "placed": "switch",
            "port": "b"
          },
          "line": "Side B to this DC motor's plus",
          "step": "ghost-wire",
          "to": {
            "placed": "motor-left",
            "port": "plus"
          }
        },
        {
          "changes": [
            {
              "from": {
                "placed": "switch",
                "port": "b"
              },
              "kind": "add-wire",
              "to": {
                "placed": "motor-left",
                "port": "plus"
              }
            }
          ],
          "line": "Wired side B to this DC motor's plus",
          "step": "do-it"
        }
      ],
      "when": {
        "kind": "unwired",
        "placed": "motor-left",
        "port": "plus"
      }
    },
    {
      "steps": [
        {
          "line": "This DC motor is not in a loop with the battery pack",
          "step": "pulse-part",
          "target": {
            "placed": "motor-right"
          }
        },
        {
          "line": "Power goes in at this DC motor's plus",
          "step": "pulse-port",
          "target": {
            "placed": "motor-right",
            "port": "plus"
          }
        },
        {
          "from": {
            "placed": "switch",
            "port": "b"
          },
          "line": "Side B to this DC motor's plus",
          "step": "ghost-wire",
          "to": {
            "placed": "motor-right",
            "port": "plus"
          }
        },
        {
          "changes": [
            {
              "from": {
                "placed": "switch",
                "port": "b"
              },
              "kind": "add-wire",
              "to": {
                "placed": "motor-right",
                "port": "plus"
              }
            }
          ],
          "line": "Wired side B to this DC motor's plus",
          "step": "do-it"
        }
      ],
      "when": {
        "kind": "unwired",
        "placed": "motor-right",
        "port": "plus"
      }
    },
    {
      "steps": [
        {
          "line": "This switch is not in a loop with the battery pack",
          "step": "pulse-part",
          "target": {
            "placed": "switch"
          }
        },
        {
          "line": "This DC motor's plus takes power straight from the battery pack, round the switch",
          "step": "pulse-port",
          "target": {
            "placed": "motor-left",
            "port": "plus"
          }
        },
        {
          "changes": [
            {
              "from": {
                "placed": "battery",
                "port": "plus"
              },
              "kind": "remove-wire",
              "to": {
                "placed": "motor-left",
                "port": "plus"
              }
            },
            {
              "from": {
                "placed": "battery",
                "port": "plus"
              },
              "kind": "remove-wire",
              "to": {
                "placed": "motor-right",
                "port": "plus"
              }
            },
            {
              "from": {
                "placed": "switch",
                "port": "b"
              },
              "kind": "add-wire",
              "to": {
                "placed": "motor-left",
                "port": "plus"
              }
            },
            {
              "from": {
                "placed": "switch",
                "port": "b"
              },
              "kind": "add-wire",
              "to": {
                "placed": "motor-right",
                "port": "plus"
              }
            }
          ],
          "line": "Moved both DC motors' plus lines from the battery pack to side B of the switch",
          "step": "do-it"
        }
      ],
      "when": {
        "failure": "outside-loop",
        "kind": "fault",
        "target": {
          "placed": "switch"
        }
      }
    },
    {
      "steps": [
        {
          "line": "The switch stops only the DC motors wired to side B",
          "step": "pulse-part",
          "target": {
            "placed": "switch"
          }
        },
        {
          "line": "Both DC motors' plus lines belong on side B",
          "step": "pulse-port",
          "target": {
            "placed": "switch",
            "port": "b"
          }
        },
        {
          "changes": [
            {
              "from": {
                "placed": "battery",
                "port": "plus"
              },
              "kind": "remove-wire",
              "to": {
                "placed": "motor-left",
                "port": "plus"
              }
            },
            {
              "from": {
                "placed": "battery",
                "port": "plus"
              },
              "kind": "remove-wire",
              "to": {
                "placed": "motor-right",
                "port": "plus"
              }
            },
            {
              "from": {
                "placed": "switch",
                "port": "b"
              },
              "kind": "add-wire",
              "to": {
                "placed": "motor-left",
                "port": "plus"
              }
            },
            {
              "from": {
                "placed": "switch",
                "port": "b"
              },
              "kind": "add-wire",
              "to": {
                "placed": "motor-right",
                "port": "plus"
              }
            }
          ],
          "line": "Moved both DC motors' plus lines to side B of the switch",
          "step": "do-it"
        }
      ]
    }
  ],
