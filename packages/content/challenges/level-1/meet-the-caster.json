{
  "arena": {
    "preset": "open-floor",
    "props": []
  },
  "goal": {
    "forTicks": 30,
    "kind": "holds",
    "when": {
      "kind": "and",
      "of": [
        {
          "atLeast": 200,
          "kind": "forward-speed",
          "target": {
            "placed": "chassis"
          }
        },
        {
          "kind": "not",
          "of": {
            "failure": "scraping",
            "kind": "fault",
            "target": {
              "placed": "chassis"
            }
          }
        }
      ]
    }
  },
  "goalLine": "Fix the caster under the chassis so the robot rolls without dragging",
  "hints": [
    {
      "steps": [
        {
          "line": "This caster is not fixed to the chassis",
          "step": "pulse-part",
          "target": {
            "part": "caster"
          }
        },
        {
          "line": "The caster fixes to this mount point under the chassis",
          "step": "pulse-port",
          "target": {
            "placed": "chassis",
            "port": "caster"
          }
        },
        {
          "from": {
            "part": "caster",
            "port": "mount"
          },
          "line": "Caster to its mount point",
          "step": "ghost-wire",
          "to": {
            "placed": "chassis",
            "port": "caster"
          }
        },
        {
          "changes": [
            {
              "from": {
                "part": "caster",
                "port": "mount"
              },
              "kind": "add-wire",
              "to": {
                "placed": "chassis",
                "port": "caster"
              }
            }
          ],
          "line": "Fixed the caster to its mount point under the chassis",
          "step": "do-it"
        }
      ],
      "when": {
        "failure": "loose",
        "kind": "fault",
        "target": {
          "part": "caster"
        }
      }
    },
    {
      "steps": [
        {
          "line": "Nothing holds up one end of this chassis",
          "step": "pulse-part",
          "target": {
            "placed": "chassis"
          }
        },
        {
          "line": "A caster fixes to this mount point under the chassis",
          "step": "pulse-port",
          "target": {
            "placed": "chassis",
            "port": "caster"
          }
        },
        {
          "changes": [
            {
              "kind": "add-part",
              "mountOn": {
                "placed": "chassis",
                "port": "caster"
              },
              "part": "caster"
            }
          ],
          "line": "Fixed a caster to its mount point under the chassis",
          "step": "do-it"
        }
      ],
      "when": {
        "kind": "missing",
        "part": "caster"
      }
    }
  ],
