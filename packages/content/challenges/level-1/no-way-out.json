  "goalLine": "Find why the robot turns, and fix it so it drives straight",
  "hints": [
    {
      "steps": [
        {
          "line": "This motor has power in but no way out",
          "step": "pulse-part",
          "target": {
            "placed": "motor-left"
          }
        },
        {
          "line": "Nothing is wired to this DC motor's minus",
          "step": "pulse-port",
          "target": {
            "placed": "motor-left",
            "port": "minus"
          }
        },
        {
          "from": {
            "placed": "motor-left",
            "port": "minus"
          },
          "line": "Minus back to minus",
          "step": "ghost-wire",
          "to": {
            "placed": "battery",
            "port": "minus"
          }
        },
        {
          "changes": [
            {
              "from": {
                "placed": "motor-left",
                "port": "minus"
              },
              "kind": "add-wire",
              "to": {
                "placed": "battery",
                "port": "minus"
              }
            }
          ],
          "line": "Wired this DC motor's minus back to the battery pack's minus",
          "step": "do-it"
        }
      ],
      "when": {
        "failure": "no-circuit",
        "kind": "fault",
        "target": {
          "placed": "motor-left"
        }
      }
    }
  ],
