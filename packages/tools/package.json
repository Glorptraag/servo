{
  "name": "@servo/tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:determinism": "SERVO_DETERMINISM=sweep vitest run test/sim-determinism.test.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "vitest run --config src/e2e/vitest.config.ts --project e2e",
    "perf": "vitest run --config src/e2e/vitest.config.ts --project performance && vitest run --config test/e2e/run-animation.config.ts --project run-animation-performance",
    "perf:app": "node src/perf/main.ts",
    "e2e:run-animation": "vitest run --config test/e2e/run-animation.config.ts",
    "gate:g3": "vite --config src/gate/vite.config.ts",
    "e2e:gate-g3": "vitest run --config test/e2e/gate-g3.config.ts"
  },
  "dependencies": {
    "@servo/app": "workspace:*",
    "@servo/canvas": "workspace:*",
    "@servo/content": "workspace:*",
    "@servo/parent": "workspace:*",
    "@servo/schema": "workspace:*",
    "@servo/sim-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "5.0.2",
    "eslint": "catalog:",
    "playwright": "1.63.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
