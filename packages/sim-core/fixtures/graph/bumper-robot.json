{
  "build": { "list": "validBlueprints", "name": "bumper-robot" },
  "nets": [
    { "ports": ["battery.minus", "buzzer.minus", "driver.minus", "servo.minus"], "wires": ["w16", "w22", "w24"] },
    { "ports": ["battery.plus", "bumper.a"], "wires": ["w14"] },
    { "ports": ["bumper.b", "buzzer.plus", "driver.plus", "servo.plus"], "wires": ["w15", "w21", "w23"] },
    { "ports": ["driver.a-minus", "motor-left.minus"], "wires": ["w18"] },
    { "ports": ["driver.a-plus", "motor-left.plus"], "wires": ["w17"] },
    { "ports": ["driver.b-minus", "motor-right.minus"], "wires": ["w20"] },
    { "ports": ["driver.b-plus", "motor-right.plus"], "wires": ["w19"] }
  ],
  "sources": [
    { "at": "battery/cells", "pos": "battery.plus", "neg": "battery.minus" },
    {
      "at": "driver/channel-a",
      "pos": "driver.a-plus",
      "neg": "driver.a-minus",
      "feeder": { "pos": "bumper.b", "neg": "battery.minus" },
      "control": "driver/channel-a"
    },
    {
      "at": "driver/channel-b",
      "pos": "driver.b-plus",
      "neg": "driver.b-minus",
      "feeder": { "pos": "bumper.b", "neg": "battery.minus" },
      "control": "driver/channel-b"
    }
  ],
  "switches": [{ "at": "bumper/contacts", "a": "battery.plus", "b": "bumper.b", "control": "bumper/contacts" }],
  "uses": [
    { "at": "buzzer/sounder", "pos": "bumper.b", "neg": "battery.minus" },
    { "at": "driver/channel-a", "pos": "bumper.b", "neg": "battery.minus" },
    { "at": "driver/channel-b", "pos": "bumper.b", "neg": "battery.minus" },
    { "at": "motor-left/motor", "pos": "driver.a-plus", "neg": "driver.a-minus" },
    { "at": "motor-right/motor", "pos": "driver.b-plus", "neg": "driver.b-minus" },
    { "at": "servo/servo", "pos": "bumper.b", "neg": "battery.minus" }
  ],
  "controls": [
    { "id": "bumper/contacts", "kind": "switch", "rest": true },
    { "id": "driver/channel-a", "kind": "channel", "rest": 1 },
    { "id": "driver/channel-b", "kind": "channel", "rest": 1 }
  ],
  "live": [
    { "on": [], "joined": [], "nets": [], "sources": ["battery/cells"] },
    {
      "on": ["bumper/contacts"],
      "joined": [["battery.plus", "bumper.b"]],
      "nets": ["battery.minus", "battery.plus", "bumper.b"],
      "sources": ["battery/cells"]
    },
    { "on": ["driver/channel-a"], "joined": [], "nets": [], "sources": ["battery/cells"] },
    {
      "on": ["bumper/contacts", "driver/channel-a"],
      "joined": [["battery.plus", "bumper.b"]],
      "nets": ["battery.minus", "battery.plus", "bumper.b", "driver.a-minus", "driver.a-plus"],
      "sources": ["battery/cells", "driver/channel-a"]
    },
    { "on": ["driver/channel-b"], "joined": [], "nets": [], "sources": ["battery/cells"] },
    {
      "on": ["bumper/contacts", "driver/channel-b"],
      "joined": [["battery.plus", "bumper.b"]],
      "nets": ["battery.minus", "battery.plus", "bumper.b", "driver.b-minus", "driver.b-plus"],
      "sources": ["battery/cells", "driver/channel-b"]
    },
    { "on": ["driver/channel-a", "driver/channel-b"], "joined": [], "nets": [], "sources": ["battery/cells"] },
    {
      "on": ["bumper/contacts", "driver/channel-a", "driver/channel-b"],
      "joined": [["battery.plus", "bumper.b"]],
      "nets": ["battery.minus", "battery.plus", "bumper.b", "driver.a-minus", "driver.a-plus", "driver.b-minus", "driver.b-plus"],
      "sources": ["battery/cells", "driver/channel-a", "driver/channel-b"]
    }
  ],
  "signals": [],
  "drives": [
    { "wire": "w10", "from": "motor-left.shaft", "to": "gear-left.input", "carried": { "x": 10, "y": 24, "z": 0, "yaw": 0, "mirrored": false } },
    { "wire": "w11", "from": "gear-left.output", "to": "wheel-left.hub", "carried": { "x": 0, "y": 26, "z": -22.5, "yaw": 0, "mirrored": false } },
    { "wire": "w12", "from": "motor-right.shaft", "to": "gear-right.input", "carried": { "x": 10, "y": 24, "z": 0, "yaw": 0, "mirrored": false } },
    { "wire": "w13", "from": "gear-right.output", "to": "wheel-right.hub", "carried": { "x": 0, "y": 26, "z": -22.5, "yaw": 0, "mirrored": false } }
  ],
  "mounts": [
    { "wire": "w1", "part": "motor-left", "mount": "mount", "on": "chassis.motor-left-inner", "local": { "x": 30, "y": 29, "z": 6, "yaw": 0, "mirrored": false } },
    { "wire": "w2", "part": "motor-right", "mount": "mount", "on": "chassis.motor-right-inner", "local": { "x": 30, "y": -29, "z": 6, "yaw": 0, "mirrored": true } },
    { "wire": "w3", "part": "gear-left", "mount": "mount", "on": "chassis.gear-left", "local": { "x": 40, "y": 53, "z": 6, "yaw": 0, "mirrored": false } },
    { "wire": "w4", "part": "gear-right", "mount": "mount", "on": "chassis.gear-right", "local": { "x": 40, "y": -53, "z": 6, "yaw": 0, "mirrored": true } },
    { "wire": "w5", "part": "battery", "mount": "mount", "on": "chassis.deck-rear", "local": { "x": -45, "y": 0, "z": 6, "yaw": 0, "mirrored": false } },
    { "wire": "w6", "part": "driver", "mount": "mount", "on": "chassis.deck-middle", "local": { "x": 0, "y": 0, "z": 6, "yaw": 0, "mirrored": false } },
    { "wire": "w7", "part": "bumper", "mount": "mount", "on": "chassis.bumper", "local": { "x": 80, "y": 0, "z": 6, "yaw": 0, "mirrored": false } },
    { "wire": "w8", "part": "caster", "mount": "mount", "on": "chassis.caster", "local": { "x": -70, "y": 0, "z": -16.5, "yaw": 0, "mirrored": false } },
    { "wire": "w9", "part": "servo", "mount": "mount", "on": "chassis.deck-front", "local": { "x": 55, "y": 0, "z": 6, "yaw": 0, "mirrored": false } }
  ],
  "placements": {
    "battery": { "by": "mount", "root": "chassis", "parent": "chassis", "x": -45, "y": 0, "z": 6, "yaw": 0, "mirrored": false },
    "bumper": { "by": "mount", "root": "chassis", "parent": "chassis", "x": 80, "y": 0, "z": 6, "yaw": 0, "mirrored": false },
    "buzzer": { "by": "root", "root": "buzzer", "x": 0, "y": 0, "z": 0, "yaw": 0, "mirrored": false },
    "caster": { "by": "mount", "root": "chassis", "parent": "chassis", "x": -70, "y": 0, "z": -16.5, "yaw": 0, "mirrored": false },
    "chassis": { "by": "root", "root": "chassis", "x": 0, "y": 0, "z": 0, "yaw": 0, "mirrored": false },
    "driver": { "by": "mount", "root": "chassis", "parent": "chassis", "x": 0, "y": 0, "z": 6, "yaw": 0, "mirrored": false },
    "gear-left": { "by": "mount", "root": "chassis", "parent": "chassis", "x": 40, "y": 53, "z": 6, "yaw": 0, "mirrored": false },
    "gear-right": { "by": "mount", "root": "chassis", "parent": "chassis", "x": 40, "y": -53, "z": 6, "yaw": 0, "mirrored": true },
    "motor-left": { "by": "mount", "root": "chassis", "parent": "chassis", "x": 30, "y": 29, "z": 6, "yaw": 0, "mirrored": false },
    "motor-right": { "by": "mount", "root": "chassis", "parent": "chassis", "x": 30, "y": -29, "z": 6, "yaw": 0, "mirrored": true },
    "servo": { "by": "mount", "root": "chassis", "parent": "chassis", "x": 55, "y": 0, "z": 6, "yaw": 0, "mirrored": false },
    "wheel-left": { "by": "carried", "root": "chassis", "parent": "gear-left", "x": 40, "y": 79, "z": -16.5, "yaw": 0, "mirrored": false },
    "wheel-right": { "by": "carried", "root": "chassis", "parent": "gear-right", "x": 40, "y": -79, "z": -16.5, "yaw": 0, "mirrored": true }
  },
  "root": "chassis",
  "pushes": [
    { "wheel": "wheel-left", "actuator": "motor-left", "root": "chassis", "push": 1 },
    { "wheel": "wheel-right", "actuator": "motor-right", "root": "chassis", "push": 1 }
  ]
}
