        "does": "Turns electricity into spinning.",
        "gives": "Gives: a spinning shaft (grey).",
        "needs": "Needs: power (red) in a loop, in at plus and out at minus.",
        "popularMechanics": "A DC motor like this spins the blades of a hand-held fan."
      },
      "failureModes": [
        {
          "cardLine": "No complete circuit: the shaft stays still.",
          "hint": "This motor is not in a loop with the battery pack",
          "id": "no-circuit",
          "need": "power",
          "shows": [
            "still"
          ],
          "teachingNote": "Current flows only round a complete loop: out of the battery pack, through the motor and back. With one wire missing, nothing flows, so the shaft stays still.",
          "unmet": "open"
        },
        {
          "cardLine": "Too little power: it turns slowly.",
          "hint": "This motor is not getting enough power",
          "id": "low-voltage",
          "need": "power",
          "shows": [
            "slow",
            "drain"
          ],
          "teachingNote": "Speed rises with voltage. On too little, such as a single cell, the motor turns slowly, and the battery pack drains more for each turn it makes.",
          "unmet": "low"
        },
        {
          "cardLine": "Too much to turn: it stops and hums.",
          "hint": "This motor cannot turn its load",
          "id": "overload",
          "need": "load",
          "shows": [
            "stall",
            "hum",
            "drain"
          ],
          "teachingNote": "A motor can turn only so much load. Asked for more, such as up a steep ramp or against a wall, the shaft stops and the motor hums while it draws the most current it ever draws, so the battery pack drains fast.",
          "unmet": "exceeded"
        },
        {
          "cardLine": "Wires swapped: it turns the other way.",
          "hint": "This motor's plus and minus are swapped",
          "id": "reversed",
          "need": "power",
          "shows": [
            "reverse"
          ],
          "teachingNote": "A DC motor turns one way when its plus meets plus, and the other way when its wires swap. On a robot, one motor wired the other way round spins it on the spot.",
          "unmet": "reversed"
        }
      ],
