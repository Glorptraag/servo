      "x": 23,
      "y": 12,
      "z": 29
    }
  },
  "card": {
    "does": "Turns to an angle you choose, and holds it.",
    "gives": "Gives: a turning arm.",
    "needs": "Needs: power (red) and a signal (yellow).",
    "popularMechanics": "The same part steers a radio-controlled car and moves a camera gimbal.",
    "specLine": "4.8–6 V · 180° · holds 1.8 kg·cm"
  },
  "failureModes": [
    {
      "cardLine": "No signal: the arm stays where it is and hums.",
      "hint": "The servo is waiting for a signal",
      "id": "no-signal",
      "need": "signal",
      "shows": [
        "hold",
        "hum"
      ],
      "teachingNote": "A servo motor turns to the angle its signal asks for. With power but no signal it has nothing to follow, so it holds where it is and hums.",
      "unmet": "absent"
    },
    {
      "cardLine": "No complete circuit: the arm stays still.",
      "id": "no-circuit",
      "need": "power",
      "shows": [
        "still"
      ],
      "teachingNote": "Without a complete loop from plus to minus the servo motor gets no power, so its arm stays still.",
      "unmet": "open"
    },
    {
      "cardLine": "Too little power: the arm moves slowly.",
      "id": "low-voltage",
      "need": "power",
      "shows": [
        "slow"
      ],
      "teachingNote": "Below 4.8 volts the servo motor sweeps slowly and weakly.",
      "unmet": "low"
    },
    {
      "cardLine": "Too much to push: the arm stops and hums.",
      "id": "overload",
      "need": "load",
      "shows": [
        "stall",
        "hum"
      ],
      "teachingNote": "A servo motor can hold or push only so much. Past that, the arm stops short of its angle and the motor hums.",
      "unmet": "exceeded"
    }
  ],
  "id": "servo-motor",
